{
  "name": "wg-easy-mcp",
  "version": "0.2.1",
  "description": "Model Context Protocol (MCP) server for administering wg-easy (WireGuard Easy) v15+ instances",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "wg-easy",
    "wireguard",
    "vpn"
  ],
  "license": "MIT",
  "author": "Willi Thiel",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ni-c/wg-easy-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/ni-c/wg-easy-mcp/issues"
  },
  "homepage": "https://github.com/ni-c/wg-easy-mcp#readme",
  "type": "module",
  "bin": {
    "wg-easy-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "undici": "^8.10.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^10.8.1",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.35.0",
    "vitest": "^3.2.0"
  }
}
