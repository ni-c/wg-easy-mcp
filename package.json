{
  "name": "wg-easy-mcp",
  "version": "0.3.0",
  "mcpName": "io.github.ni-c/wg-easy-mcp",
  "description": "Model Context Protocol (MCP) server for administering wg-easy (WireGuard Easy) v15+ instances",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "wg-easy",
    "wireguard",
    "vpn"
  ],
  "license": "MIT",
  "author": "Willi Thiel",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ni-c/wg-easy-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/ni-c/wg-easy-mcp/issues"
  },
  "homepage": "https://github.com/ni-c/wg-easy-mcp#readme",
  "type": "module",
  "bin": {
    "wg-easy-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build",
    "assets": "node scripts/gen-assets.mjs",
    "assets:check": "node scripts/gen-assets.mjs --check"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "undici": "^8.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "prettier": "^3.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
